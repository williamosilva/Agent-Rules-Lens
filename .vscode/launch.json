{
  "version": "0.2.0",
  "configurations": [
    {
      "name": "Run Extension (sample workspace)",
      "type": "extensionHost",
      "request": "launch",
      "args": [
        "${workspaceFolder}/examples/sample-workspace",
        "--extensionDevelopmentPath=${workspaceFolder}"
      ],
      "outFiles": ["${workspaceFolder}/dist/**/*.js"],
      "preLaunchTask": "npm: compile"
    }
  ]
}
